      = (315 / 512 : ℝ) * (∑ i, α i * h8c0 (a i) (b i) (c i)) ^ 2 + (35 / 2048 : ℝ) * (∑ i, α i * h8c1 (a i) (b i) (c i)) ^ 2 + (35 / 2048 : ℝ) * (∑ i, α i * h8s1 (a i) (b i) (c i)) ^ 2 + (1 / 4096 : ℝ) * (∑ i, α i * h8c2 (a i) (b i) (c i)) ^ 2 + (1 / 4096 : ℝ) * (∑ i, α i * h8s2 (a i) (b i) (c i)) ^ 2 + (1 / 270336 : ℝ) * (∑ i, α i * h8c3 (a i) (b i) (c i)) ^ 2 + (1 / 270336 : ℝ) * (∑ i, α i * h8s3 (a i) (b i) (c i)) ^ 2 + (1 / 16220160 : ℝ) * (∑ i, α i * h8c4 (a i) (b i) (c i)) ^ 2 + (1 / 16220160 : ℝ) * (∑ i, α i * h8s4 (a i) (b i) (c i)) ^ 2 + (1 / 843448320 : ℝ) * (∑ i, α i * h8c5 (a i) (b i) (c i)) ^ 2 + (1 / 843448320 : ℝ) * (∑ i, α i * h8s5 (a i) (b i) (c i)) ^ 2 + (1 / 35424829440 : ℝ) * (∑ i, α i * h8c6 (a i) (b i) (c i)) ^ 2 + (1 / 35424829440 : ℝ) * (∑ i, α i * h8s6 (a i) (b i) (c i)) ^ 2 + (1 / 1062744883200 : ℝ) * (∑ i, α i * h8c7 (a i) (b i) (c i)) ^ 2 + (1 / 1062744883200 : ℝ) * (∑ i, α i * h8s7 (a i) (b i) (c i)) ^ 2 + (1 / 17003918131200 : ℝ) * (∑ i, α i * h8c8 (a i) (b i) (c i)) ^ 2 + (1 / 17003918131200 : ℝ) * (∑ i, α i * h8s8 (a i) (b i) (c i)) ^ 2 := by
  simp only [sum_sq_eq, Finset.mul_sum, ← Finset.sum_add_distrib]
  refine Finset.sum_congr rfl fun i _ => Finset.sum_congr rfl fun j _ => ?_
  rw [qV_sos_8]
  ring

/-- **The kernels are positive semidefinite.** For `k ≤ 8` and any finite family of vectors of `ℝ³`
with coordinates `a i, b i, c i`, the quadratic form of the kernel `qV` is nonnegative. -/
theorem qV_quad_nonneg {ι : Type*} [Fintype ι] (k : ℕ) (hk : k ≤ 8) (α a b c : ι → ℝ) :
    0 ≤ ∑ i, ∑ j, α i * α j * qV (a i * a j + b i * b j + c i * c j)
        ((a i ^ 2 + b i ^ 2 + c i ^ 2) * (a j ^ 2 + b j ^ 2 + c j ^ 2)) k := by
  interval_cases k
  · rw [qV_quad_0]; positivity
  · rw [qV_quad_1]; positivity
  · rw [qV_quad_2]; positivity
  · rw [qV_quad_3]; positivity
  · rw [qV_quad_4]; positivity
  · rw [qV_quad_5]; positivity
  · rw [qV_quad_6]; positivity
  · rw [qV_quad_7]; positivity
  · rw [qV_quad_8]; positivity

end CAP.Wsos
