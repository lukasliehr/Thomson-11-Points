    (hg : HasPat x p 11 gStar) :
    InCell 11 (N11G.IN_c2_d150_D6_c0030.dom.iv) x p ∨ EnergyGt 4059645051 100000000 x := by
  by_cases hb : InCell 11 (N11G.IN_c2_d150_D6_c0030.dom.iv) x p
